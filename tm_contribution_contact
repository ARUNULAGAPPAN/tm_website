<!DOCTYPE html>
<html lang="ta">
<head>
  <meta charset="UTF-8">
  <title>Association Payment Details</title>
  <style>
    :root {
      --primary-red: #d32f2f;
      --primary-black: #212121;
      --primary-white: #ffffff;
      --accent-gold: #d4af37;
      --light-gray: #f5f5f5;
      --dark-gray: #3a3a3a;
    }

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: var(--dark-gray);
      color: var(--primary-white);
    }

    h2 {
      text-align: center;
      color: var(--primary-red);
      font-size: 28px;
      margin-bottom: 30px;
    }

    .container {
      max-width: 650px;
      margin: 60px auto;
      background-color: var(--primary-white);
      color: var(--primary-black);
      border-radius: 12px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
      padding: 40px;
    }

    .section {
      margin-bottom: 40px;
    }

    .section:last-child {
      margin-bottom: 0;
    }

    .section-title {
      font-size: 20px;
      margin-bottom: 15px;
      color: var(--primary-black);
      border-bottom: 2px solid var(--accent-gold);
      padding-bottom: 8px;
    }

    .bank-details p,
    .contact-details p {
      margin: 10px 0;
      line-height: 1.7;
      font-size: 16px;
      text-align: left;
    }

    .qr-placeholder {
      height: 250px;
      width: 250px;
      border: 2px dashed var(--primary-red);
      margin: 30px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary-black);
      font-size: 16px;
      background-color: var(--light-gray);
      border-radius: 10px;
    }

    .contact-details {
      text-align: left;
    }

    /* Hanging indent for address */
    .address-text {
      padding-left: 70px;   /* shift whole block */
      text-indent: -65px;   /* pull back first line so 'Address:' stays */
    }
  </style>
</head>
<body>

  <div class="container">
    <h2>நிதியுதவி மூலம் எங்களுக்கு உதவிட</h2>

    <div class="section bank-details">
      <div class="section-title">வங்கி கணக்கு விவரங்கள்</div>
      <p><strong>வங்கியின் பெயர்:</strong> இந்தியன் வங்கி</p>
      <p><strong>சேமிப்பு கணக்கு எண்:</strong> 6561111641</p>
      <p><strong>IFSC எண்:</strong> IDIB000C028</p>
      <p><strong>கிளை:</strong> குரோம்பேட்டை</p>
    </div>

    <div class="section">
      <div class="section-title">QR குறியீடு</div>
      <div class="qr-placeholder">QR Code Placeholder</div>
    </div>

    <div class="section contact-details">
      <div class="section-title">தொடர்புக்கு</div>
      <p><strong>Email:</strong> yourmail@example.com</p>
      <p><strong>Phone:</strong> +91 98765 43210</p>
      <p class="address-text"><strong>Address:</strong> மெட்ராஸ் தொழில்நுட்பக் கல்லூரி,<br>
        அண்ணா பல்கலைக்கழகம்<br>
        சென்னை 600044</p>
    </div>
  </div>

</body>
</html>
